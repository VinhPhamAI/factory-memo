OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/coding/v3

# PostgreSQL + pgvector knowledge base (see deployments/docker-compose.yml)
DATABASE_URL=postgresql+psycopg://voice_agent:voice_agent@localhost:5434/voice_agent

# OpenAI-compatible embedding API
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
# Must match the model's output size; changing it requires a new knowledge table.
EMBEDDING_DIM=
# Set to true only if the provider accepts the `dimensions` request parameter.
EMBEDDING_SEND_DIMENSIONS=false
