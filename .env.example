# Benchmark data generation / LLM judge (benchmark/llm_client.py), OpenAI-compatible
MODELARK_BASEURL=
MODELARK_APIKEY=
MODELARK_MODELNAME=

# ModelArk bulk options (both need a ModelArk platform API key, not a Coding Plan key):
# - Online inference (Flex): EXTRACTION_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
#   and EXTRACTION_SERVICE_TIER=flex
# - Batch Chat (deprecated): EXTRACTION_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3/batch
#   and EXTRACTION_MODEL=<batch inference endpoint ID>
# Queued requests can wait a long time: raise EXTRACTION_TIMEOUT_SECONDS (e.g. 86400).
EXTRACTION_API_KEY=
EXTRACTION_MODEL=
EXTRACTION_BASE_URL=
EXTRACTION_SERVICE_TIER=
EXTRACTION_TIMEOUT_SECONDS=
# Maximum completion tokens for each extraction request (default: 20000).
EXTRACTION_MAX_TOKENS=
# ModelArk/DeepSeek: disabled saves reasoning tokens for direct extraction.
# Leave blank for other providers; enabled restores reasoning.
EXTRACTION_THINKING=

# Optional LLM faithfulness judge for `kb ingest --verify llm`; ideally another
# model family than extraction. Same keys as EXTRACTION_* (blank = OPENROUTER_*).
VERIFY_API_KEY=
VERIFY_MODEL=
VERIFY_BASE_URL=
VERIFY_THINKING=
# Consolidation of new knowledge with stored lessons during `kb ingest`
# (disable with --no-consolidate). Same keys as EXTRACTION_*.
CONSOLIDATION_API_KEY=
CONSOLIDATION_MODEL=
CONSOLIDATION_BASE_URL=
CONSOLIDATION_THINKING=
# Answer model of the industrial_qa benchmark runner. Same keys as EXTRACTION_*.
ANSWER_API_KEY=
ANSWER_MODEL=
ANSWER_BASE_URL=
ANSWER_THINKING=
# industrial_qa pipeline settings (retrieval, rerank mode, vector threshold, LLM
# models/thinking/token limits per step, ingestion, prompts) for the API and runners;
# empty uses backend/knowledge_bases/industrial_qa/config.toml. Values set there
# override the ANSWER_*/EXTRACTION_*/VERIFY_*/CONSOLIDATION_* model, thinking and
# max-token settings and KNOWLEDGE_MIN_VECTOR_SIMILARITY for industrial_qa only.
# Runners also accept --config.
INDUSTRIAL_QA_CONFIG=
# Readable transcript of voice recordings (UI toggle "Làm sạch transcript").
# Same keys as EXTRACTION_*; a small non-reasoning model is enough. With a
# ModelArk/DeepSeek reasoning model set CLEANING_THINKING=disabled, or the
# reasoning can use up the output budget before any text is written.
CLEANING_API_KEY=
CLEANING_MODEL=
CLEANING_BASE_URL=
CLEANING_THINKING=

# PostgreSQL + pgvector server (see deployments/docker-compose.yml). Each knowledge
# base is stored in its own database kb_<name> on this server, created on first
# use; the database in this URL is only used to create and drop those.
DATABASE_URL=postgresql+psycopg://voice_agent:voice_agent@localhost:5434/voice_agent
# Separate database for the new application tables managed by Alembic. It must
# not be the DATABASE_URL database, which holds the service's own ingestion_jobs.
# Create it once: CREATE DATABASE voice_agent_app;
APP_DATABASE_URL=postgresql+psycopg://voice_agent:voice_agent@localhost:5434/voice_agent_app
# Optional setup-owner account for `uv run alembic upgrade head`; takes precedence
# over APP_DATABASE_URL. See docs/development/database-migrations.md.
MIGRATION_DATABASE_URL=

# Docker Compose API (host-run clients still use DATABASE_URL above).
API_PORT=8005
# Optional overrides; defaults use postgres:5432 and speech-api:8080 internally.
API_DATABASE_URL=
API_SPEECH_API_URL=
# For model/embedding servers running on the Docker host, use
# http://host.docker.internal:<port>/... instead of localhost in their *_BASE_URL.

# OpenAI-compatible embedding API
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
# Optional for local servers such as text-embeddings-inference (TEI), e.g.
# EMBEDDING_BASE_URL=http://localhost:8080/v1 with no EMBEDDING_API_KEY.
# Max inputs per request (TEI: max_client_batch_size from GET /info).
EMBEDDING_BATCH_SIZE=
# Query instructions live in backend/knowledge_bases/<kb>/embedding_query.md.
# Must match the model's output size; after changing the model run
# `python -m backend.scripts.kb reembed <kb>` for each knowledge base.
EMBEDDING_DIM=
# Set to true only if the provider accepts the `dimensions` request parameter.
EMBEDDING_SEND_DIMENSIONS=false

# Cosine similarity (0..1) at which a vector hit counts as confident. It only
# labels hits: when nothing clears it, the nearest records are still returned
# as low_confidence. Calibrate per embedding model: ~0.3 for
# llama-nemotron-embed-vl-1b-v2, ~0.6 for harrier-oss-v1-0.6b with an instruction.
KNOWLEDGE_MIN_VECTOR_SIMILARITY=0.3

# Industrial QA extracted-knowledge snapshots on Hugging Face.
# HF_TOKEN needs write access for push; public datasets can be pulled without it.
HF_TOKEN=
HF_DATASET_REPO_ID=duonganh2973/industrial_qa

# Speech service (VieGem-ASR speech-api in deployments/ai.compose.yml; see
# deployments/speech/README.md). HF_TOKEN above is optional for its downloads.
SPEECH_API_URL=http://127.0.0.1:8080
SPEECH_API_PORT=8080
SPEECH_GPU_ID=0
# Locale recorded with transcripts. VieGem-ASR recognizes Vietnamese (with
# English terms) whatever this says.
SPEECH_LANGUAGE=vi-VN
# Silence (ms) after the last recognized word that ends an utterance.
SPEECH_EOU_MS=800
# Clips per GPU batch, and 1 to try torch.compile (benchmark before enabling).
SPEECH_MAX_BATCH=8
SPEECH_COMPILE=0
# Silero voice activity detection: 1 (default) runs the ASR model only on
# speech, 0 disables it. The threshold (0.1-0.9) is the speech probability a
# 32 ms chunk needs; lower it if quiet speech is missed.
SPEECH_VAD=1
SPEECH_VAD_THRESHOLD=0.5

# OCR service (PaddleOCR-VL-1.6: ocr-api + ocr-vlm in deployments/ai.compose.yml;
# see deployments/ocr/README.md). ocr-api listens on 127.0.0.1:OCR_API_PORT.
OCR_API_PORT=8090
OCR_GPU_ID=0
# 1 loads the orientation/unwarping models so requests can ask for them.
OCR_DOC_PREPROCESSING=0
OCR_MAX_UPLOAD_MB=50
OCR_MAX_PAGES=100
# Documents that may wait while one is processed; more get HTTP 503.
OCR_MAX_QUEUE=4
OCR_LAYOUT_BATCH=1
# Voice capture (frontend "Ghi âm"): recordings are saved as WAV here
# (default data/audio). VOICE_VERIFY is off, quotes (default) or llm;
# VOICE_CONSOLIDATE=false stores new records without consolidation.
# For industrial_qa, [ingestion] in its config.toml takes precedence over both.
VOICE_AUDIO_DIR=
# Original document objects and metadata; default <project>/data/uploads.
# Docker Compose fixes this to /app/data/uploads in its document_uploads volume.
DOCUMENT_UPLOAD_DIR=
VOICE_VERIFY=quotes
VOICE_CONSOLIDATE=true
# Job workers (`python -m backend.worker`, Compose service "worker"): processes
# per stage (default 1 each), fallback poll / heartbeat / stale-lease seconds
# (15 / 15 / 180) and seconds a running job may finish on shutdown (90).
WORKER_CONVERT_PROCESSES=
WORKER_EXTRACT_PROCESSES=
WORKER_CONFLICT_PROCESSES=
WORKER_POLL_S=
WORKER_HEARTBEAT_S=
WORKER_STALE_S=
WORKER_SHUTDOWN_GRACE_S=
WORKER_LOG_LEVEL=
# Attempts per job (default 3) and first retry delay in seconds, doubled per
# attempt up to one hour (default 30).
JOB_MAX_ATTEMPTS=
JOB_RETRY_DELAY_S=
# Seconds after which a running extraction run stops blocking identical content
# (its worker died for good; default 3600, minimum 60).
EXTRACTION_RUN_STALE_S=
# Near-duplicate warning before extraction (5-word shingles, same KB and mode).
# Jaccard / containment at or above these need confirmation (defaults 0.9 / 0.9);
# any score at or above NEAR_DUPLICATE_INFO is shown for information (default 0.6).
# Values in (0, 1]. Tune with backend/scripts/near_duplicate_report.py.
NEAR_DUPLICATE_JACCARD=
NEAR_DUPLICATE_CONTAINMENT=
NEAR_DUPLICATE_INFO=
# Most knowledge bases that can be created from the UI (default 50).
KB_MAX_CREATED=
