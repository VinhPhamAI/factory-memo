VITE_DATA_MODE=api
VITE_API_BASE_URL=
# Vite dev proxy target; use a same-origin /v1 reverse proxy in production.
BACKEND_URL=http://127.0.0.1:8005

# Show the mock 3D machine-diagnosis panel in chat (true/false).
# Independent of VITE_DATA_MODE: enabled, it appears with the mock demo and the live agent.
VITE_MACHINE_DIAGNOSIS_VIZ=false
