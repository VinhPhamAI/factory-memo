# Copy to agent/.env. Replace placeholder secrets in both runtime and setup files.
AGENT_API_TOKEN=replace-with-a-long-random-service-secret
MODELARK_API_KEY=replace-with-modelark-api-key
MODELARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
MODELARK_MODEL=replace-with-your-model-or-endpoint-id
AGENT_DATABASE_URL=postgresql://agent_runtime:replace-runtime-password@localhost:5434/agent_memory
AGENT_CONTAINER_DATABASE_URL=postgresql://agent_runtime:replace-runtime-password@postgres:5432/agent_memory
AGENT_REQUEST_TIMEOUT_SECONDS=120
AGENT_MAX_OUTPUT_TOKENS=1024
AGENT_MAX_CONCURRENT_REQUESTS=4
AGENT_CONTEXT_MAX_MESSAGES=40
AGENT_CONTEXT_MAX_CHARACTERS=60000
AGENT_SEARCH_TIMEOUT_SECONDS=10
# Native backend address. The Compose agent uses the container address below.
AGENT_KB_BACKEND_URL=http://127.0.0.1:8005
AGENT_CONTAINER_KB_BACKEND_URL=http://api:8005
AGENT_SEARCH_MAX_RESULTS=5
AGENT_SEARCH_MAX_EXCERPT_CHARACTERS=1500
AGENT_HISTORY_MAX_MESSAGES=200
AGENT_HISTORY_MAX_CHARACTERS=400000
AGENT_PORT=8010
