# Copy to agent/.env.setup. Bootstrap defaults match the existing local Compose DB.
AGENT_BOOTSTRAP_DATABASE_URL=postgresql://voice_agent:voice_agent@localhost:5434/voice_agent
AGENT_SETUP_DATABASE_URL=postgresql://agent_owner:replace-owner-password@localhost:5434/agent_memory
AGENT_DATABASE_URL=postgresql://agent_runtime:replace-runtime-password@localhost:5434/agent_memory
AGENT_CONTAINER_BOOTSTRAP_DATABASE_URL=postgresql://voice_agent:voice_agent@postgres:5432/voice_agent
AGENT_CONTAINER_SETUP_DATABASE_URL=postgresql://agent_owner:replace-owner-password@postgres:5432/agent_memory
